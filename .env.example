GATEGO_JWT_SECRET=replace-with-a-long-random-secret
GATEGO_ADMIN_KEY=replace-with-a-long-random-admin-key
GATEGO_REDIS_ADDR=redis:6379
GATEGO_REDIS_PASSWORD=
GATEGO_REDIS_DB=0
# Only enable behind a trusted proxy/ingress that sanitizes forwarded headers.
GATEGO_TRUST_FORWARDED_HEADERS=false
OTEL_SERVICE_NAME=gatego
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
